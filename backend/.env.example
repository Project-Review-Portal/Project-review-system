# Server configuration
PORT=3626

# Database configuration (Use local DB for development, Atlas for cmn/testing)
# Local DB URI: mongodb://localhost:27017/project-review-system
# Atlas DB URI: mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/project-review-system?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/project-review-system

# Authentication JWT key
JWT_SECRET=your-secret-key-here-change-in-production

# SMTP Email notification settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
